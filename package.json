{
  "name": "cvmux",
  "version": "0.1.1",
  "private": true,
  "description": "A cmux-inspired terminal workspace manager for Windows — run many PowerShell sessions and watch them all from one sidebar.",
  "author": "iseungsang01",
  "license": "GPL-3.0-or-later",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "npm run build:cli && electron-vite dev",
    "build": "electron-vite build && npm run build:cli",
    "build:cli": "esbuild src/cli/index.ts --bundle --platform=node --format=esm --outfile=out/cli/cvmux.mjs --tsconfig=tsconfig.esbuild.json --banner:js=\"#!/usr/bin/env node\" --log-level=warning",
    "start": "electron-vite preview",
    "package": "npm run build && electron-builder --win",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "npm run test:state && npm run test:layout && npm run test:format && npm run test:tree && npm run test:protocol && npm run test:socket && npm run test:palette && npm run test:inbox && npm run test:config && npm run test:browser && npm run test:meta && npm run test:windows",
    "test:windows": "esbuild tests/windows.test.ts --bundle --platform=node --format=esm --outfile=out/tests/windows.mjs --external:electron --external:node-pty --tsconfig=tsconfig.esbuild.json --log-level=warning && node out/tests/windows.mjs",
    "test:state": "esbuild tests/session-state.test.ts --bundle --platform=node --format=esm --outfile=out/tests/session-state.mjs --external:electron --external:node-pty --tsconfig=tsconfig.esbuild.json --log-level=warning && node out/tests/session-state.mjs",
    "test:layout": "esbuild tests/layout.test.ts --bundle --platform=node --format=esm --outfile=out/tests/layout.mjs --external:electron --external:node-pty --tsconfig=tsconfig.esbuild.json --log-level=warning && node out/tests/layout.mjs",
    "test:format": "esbuild tests/format.test.ts --bundle --platform=node --format=esm --outfile=out/tests/format.mjs --external:electron --external:node-pty --tsconfig=tsconfig.esbuild.json --log-level=warning && node out/tests/format.mjs",
    "test:tree": "esbuild tests/process-tree.test.ts --bundle --platform=node --format=esm --outfile=out/tests/process-tree.mjs --external:electron --external:node-pty --tsconfig=tsconfig.esbuild.json --log-level=warning && node out/tests/process-tree.mjs",
    "test:socket": "esbuild tests/control-socket.test.ts --bundle --platform=node --format=esm --outfile=out/tests/control-socket.mjs --external:electron --external:node-pty --tsconfig=tsconfig.esbuild.json --log-level=warning && node out/tests/control-socket.mjs",
    "test:protocol": "esbuild tests/protocol.test.ts --bundle --platform=node --format=esm --outfile=out/tests/protocol.mjs --external:electron --external:node-pty --tsconfig=tsconfig.esbuild.json --log-level=warning && node out/tests/protocol.mjs",
    "test:palette": "esbuild tests/palette.test.ts --bundle --platform=node --format=esm --outfile=out/tests/palette.mjs --external:electron --external:node-pty --tsconfig=tsconfig.esbuild.json --log-level=warning && node out/tests/palette.mjs",
    "test:inbox": "esbuild tests/notifications.test.ts --bundle --platform=node --format=esm --outfile=out/tests/notifications.mjs --external:electron --external:node-pty --tsconfig=tsconfig.esbuild.json --log-level=warning && node out/tests/notifications.mjs",
    "test:config": "esbuild tests/config.test.ts --bundle --platform=node --format=esm --outfile=out/tests/config.mjs --external:electron --external:node-pty --tsconfig=tsconfig.esbuild.json --log-level=warning && node out/tests/config.mjs",
    "test:browser": "esbuild tests/browser.test.ts --bundle --platform=node --format=esm --outfile=out/tests/browser.mjs --external:electron --external:node-pty --tsconfig=tsconfig.esbuild.json --log-level=warning && node out/tests/browser.mjs",
    "test:meta": "esbuild tests/workspace-meta.test.ts --bundle --platform=node --format=esm --outfile=out/tests/workspace-meta.mjs --external:electron --external:node-pty --tsconfig=tsconfig.esbuild.json --log-level=warning && node out/tests/workspace-meta.mjs"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "electron-updater": "^6.8.9",
    "node-pty": "^1.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "allowScripts": {
    "node-pty@1.1.0": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6"
  }
}
